// app.rc - program icon, version information and manifest embedded in the executable.
// Compiled by rc.exe (MSVC), windres (MinGW) or passed directly to zig c++.

#include <winver.h>
#include <winuser.h>

1 ICON "../assets/icon.ico"
1 24 "app.manifest"   // 24 = RT_MANIFEST, 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Omnya Technology"
            VALUE "FileDescription", "Al-Mushaf Al-Sharif - The Noble Quran"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "AlMushafAlSharif"
            VALUE "LegalCopyright", "(c) 2026 Omnya Technology"
            VALUE "OriginalFilename", "AlMushafAlSharif.exe"
            VALUE "ProductName", "Al-Mushaf Al-Sharif"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
